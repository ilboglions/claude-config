# Copy to ~/.config/zotero-mcp.env (chmod 600); the MCP server sources it at launch.
# Keep the single quotes: unquoted values with * or $ break when the file is sourced.
# Key and user ID: https://www.zotero.org/settings/keys
export ZOTERO_API_KEY='your-api-key'
export ZOTERO_LIBRARY_ID='your-numeric-user-id'

# WebDAV file syncing: same server as Zotero > Settings > Sync, but the URL must
# include the zotero/ folder Zotero creates there. Delete these lines if unused.
export ZOTERO_WEBDAV_URL='https://dav.example.com/path/zotero/'
export ZOTERO_WEBDAV_USERNAME='your-webdav-user'
export ZOTERO_WEBDAV_PASSWORD='your-webdav-password'
