{
  "permissions": {
    "allow": [
      "Bash(squeue *)",
      "Bash(sacct *)",
      "Bash(sinfo *)",
      "Bash(scontrol show *)",
      "Bash(sstat *)",
      "Bash(sshare *)",
      "Bash(sprio *)",
      "Bash(savail)",
      "Bash(disk-quota)",
      "Bash(hostname)",
      "Bash(nvidia-smi)",
      "Bash(nvidia-smi *)",
      "Bash(module list)",
      "Bash(module avail *)",
      "Bash(module spider *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(python --version)",
      "Bash(pip list *)",
      "Bash(pip show *)",
      "Bash(~/.claude/skills/ooo/tg.py *)",
      "mcp__zotero",
      "mcp__research-site"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ],
    "ask": [
      "Bash(sbatch *)",
      "Bash(srun *)",
      "Bash(salloc *)",
      "Bash(scancel *)",
      "mcp__zotero__zotero_delete_item",
      "mcp__zotero__zotero_delete_collection",
      "mcp__zotero__zotero_delete_annotation",
      "mcp__zotero__zotero_batch_update",
      "mcp__zotero__zotero_add_item",
      "mcp__zotero__zotero_attach_file"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "opus",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/ooo/tg.py hook",
            "timeout": 86400
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/ooo/tg.py stop",
            "timeout": 604800,
            "asyncRewake": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/ooo/tg.py session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/ooo/tg.py session-end",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if ls ~/.claude/tg*/inbox/\"$CLAUDE_CODE_SESSION_ID\"/*.json >/dev/null 2>&1; then exec ~/.claude/skills/ooo/tg.py interrupt; fi",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "if ls ~/.claude/tg*/inbox/\"$CLAUDE_CODE_SESSION_ID\"/*.json >/dev/null 2>&1; then exec ~/.claude/skills/ooo/tg.py wake; fi",
            "asyncRewake": true,
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "for f in ~/.claude/tg*/sessions/\"$CLAUDE_CODE_SESSION_ID\".json ~/.claude/tg*/away/\"$CLAUDE_CODE_SESSION_ID\"; do [ -e \"$f\" ] && exec ~/.claude/skills/ooo/tg.py busy; done; true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "theme": "auto",
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "idleCompaction": false
}
