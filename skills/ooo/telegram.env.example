# Copy to ~/.config/telegram.env and chmod 600. Read by skills/ooo/tg.py.
# Token from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=
# Your own Telegram user id: run `tg.py chat-id` and message the bot.
# The router ignores everyone else.
TELEGRAM_CHAT_ID=

# Optional: a hub that runs the bots instead (see README, "Away mode (Telegram)").
# With these set, `tg.py router` and `tg.py mirror` keep this machine's mailboxes in
# sync with the hub, and the router talks to Telegram itself only while the hub is
# unreachable (that needs the bot token above on this machine).
#TG_HUB_URL=https://hub.example.org
#TG_HUB_CERT=~/.config/telegram-hub.crt
#TG_HUB_KEY=~/.config/telegram-hub.key
# The bot a session uses unless its project sets TG_BOT: work (default) or another.
#TG_DEFAULT_BOT=work
# For a machine reached only through Telegram (say, an always-on assistant): every
# session there starts in away mode, as if /ooo had been typed.
#TG_ALWAYS_AWAY=1
